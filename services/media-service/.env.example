# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase dashboard -> Connect -> Session pooler. Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# AWS (uses your local AWS profile for credentials)
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
S3_BUCKET=<your-bucket-name>

# Presigned URL lifetime in seconds
UPLOAD_URL_EXPIRES=900
DOWNLOAD_URL_EXPIRES=3600

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
